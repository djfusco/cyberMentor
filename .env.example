HOST=127.0.0.1
PORT=8080

DATABASE_URL=sqlite:///./mentor.db

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder-next:latest
# Multimodal model for vision-assisted evaluation at Finish time. Pull it
# separately, e.g.: ollama pull llava
# Set to an empty value to disable vision-assisted evaluation entirely.
OLLAMA_VISION_MODEL=llava:latest

# Per-call timeout (seconds) for the "Ask About This Session" LLM calls only.
# Separate from the default Ollama timeout so a slower evidence-grounded query
# can run longer without raising the mentor/evaluator timeouts.
SESSION_QUERY_TIMEOUT_SECONDS=180

# Authoring-only "Research a Task" feature (see README > Instructor Tools).
# This is a narrow, deliberate exception to the local-only design -- it is
# never used for student session data. Required only if you want to use
# that feature. Shared with MENTOR_CHAT_PROVIDER=frontier below.
FRONTIER_PROVIDER=openai
FRONTIER_API_KEY=
FRONTIER_MODEL=gpt-4o

# Which backend answers in-exercise mentor chat questions: "ollama"
# (default, fully local) or "frontier" (opt-in -- for people who can't run
# Ollama locally; reuses FRONTIER_PROVIDER/FRONTIER_API_KEY/FRONTIER_MODEL
# above, so exercise/evidence context is sent to that provider instead of
# staying on localhost). Only mentor chat is affected -- evaluation,
# session Q&A, authoring, and mentor review always stay Ollama-only.
MENTOR_CHAT_PROVIDER=ollama

# Evidence capture provider: "native_mac" (default, macOS Swift helper),
# "native_windows" (Windows mentor-capture.exe), or "rust" (cross-platform
# Rust capture helper; intended to eventually replace the platform-specific
# native helpers). See app/dependencies.py::create_evidence_provider.
EVIDENCE_PROVIDER=native_mac

# Native capture helper executable + shared output directory. The macOS
# helper is built with `swift build` (native_capture/); the Windows helper is
# published with `dotnet publish` (native_capture/windows/). Relative paths
# resolve against the project root.
NATIVE_CAPTURE_EXECUTABLE=./native_capture/.build/debug/mentor-capture
# Only used when EVIDENCE_PROVIDER=native_windows. Default below assumes
# `dotnet publish -o bin` from native_capture/windows/.
NATIVE_WINDOWS_CAPTURE_EXECUTABLE=./native_capture/windows/bin/mentor-capture.exe
# Only used when EVIDENCE_PROVIDER=rust. Cross-platform Rust capture helper,
# built with `cargo build` (native_capture/rust/). The Rust helper emits
# screenshot events (no OCR); the provider OCRs saved frames app-side
# (macOS Vision via pyobjc; see app/services/ocr.py).
NATIVE_RUST_CAPTURE_EXECUTABLE=./native_capture/rust/target/debug/cyberalfred-capture
NATIVE_CAPTURE_OUTPUT=./capture_sessions
